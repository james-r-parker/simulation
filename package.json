{
  "name": "blob-evolution-simulation",
  "version": "5.0.0",
  "description": "Artificial life simulation using neuroevolution with WebGL rendering",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist",
    "check": "scripts/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "designs:index": "node scripts/designs-index.mjs --write",
    "perf:browser": "node scripts/browser-perf.mjs",
    "browser:hash": "node scripts/browser-hash.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:micro": "node scripts/bench-micro.mjs",
    "bench:parallel": "node scripts/bench-parallel.mjs",
    "replay": "node scripts/replay.mjs",
    "eval": "node scripts/eval.mjs",
    "eval:compare": "node scripts/eval-compare.mjs",
    "eval:power": "node scripts/eval-power.mjs",
    "league": "node scripts/league.mjs",
    "probe:memory": "node scripts/memory-probe.mjs",
    "ladder": "node scripts/ladder.mjs",
    "screen": "node scripts/screen.mjs",
    "aspire:dashboard": "aspire dashboard run --frontend-url http://127.0.0.1:18888 --otlp-grpc-url http://127.0.0.1:4317 --otlp-http-url http://127.0.0.1:4318 --allow-anonymous"
  },
  "keywords": [
    "simulation",
    "evolution",
    "neural-network",
    "webgl",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.1",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "prettier": "3.9.10",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "uplot": "1.6.32"
  }
}
