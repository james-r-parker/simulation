{
  "name": "blob-evolution-simulation",
  "version": "5.0.0",
  "description": "Artificial life simulation using neuroevolution with WebGL rendering",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "dev": "vite",
    "serve": "npx http-server -p 8000 -c-1",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist",
    "check": "scripts/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "designs:index": "node scripts/designs-index.mjs --write",
    "perf:browser": "node scripts/browser-perf.mjs"
  },
  "keywords": [
    "simulation",
    "evolution",
    "neural-network",
    "webgl",
    "three.js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.0",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "prettier": "3.9.10",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24"
  }
}
