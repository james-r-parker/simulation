{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "WebWorker"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "js/sim/**/*.js",
    "js/evo/**/*.js",
    "js/dev/**/*.js",
    "js/worker/**/*.js",
    "js/app/**/*.js",
    "scripts/**/*.mjs",
    "scripts/browser/**/*.js",
    "test/**/*.js"
  ],
  "exclude": ["test/fixtures"]
}
